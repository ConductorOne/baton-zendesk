      "PageSize": {
        "name": "page[size]",
        "in": "query",
        "description": "Cursor page size, hardcoded to 100. Load-bearing: omitting it makes Zendesk fall back to offset pagination and drop `meta` from the response, which stops the sync after the first page.",
        "schema": {
          "type": "integer",
          "default": 100
        }
      },
      "PageAfter": {
        "name": "page[after]",
