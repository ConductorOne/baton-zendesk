    "/group_memberships.json": {
      "get": {
        "operationId": "listGroupMemberships",
        "tags": [
          "groups"
        ],
        "summary": "List group memberships",
        "description": "Hit two different ways. The grant sync pages by cursor, filtering on `group_id`. The provisioning path (finding an existing membership before deleting it) pages by offset with `page`, filtering on both `group_id` and `user_id` — it walks pages until it finds the matching pair. Sending the cursor and offset parameter sets together is not supported.",
        "externalDocs": {
          "url": "https://developer.zendesk.com/api-reference/ticketing/groups/group_memberships/#list-memberships"
        },
        "parameters": [
          {
            "name": "group_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "user_id",
            "in": "query",
            "description": "Sent only on the offset-paginated provisioning lookup.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "$ref": "#/components/parameters/PageAfter"
          },
          {
            "$ref": "#/components/parameters/PageNumber"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of group memberships.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupMembershipsResponse"
                }
              }
            }
          }
        }
      },
